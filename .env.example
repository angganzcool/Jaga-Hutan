# ==============================================================================
# JAGA HUTAN - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. NASA FIRMS API CONFIGURATION
# Dapatkan MAP_KEY gratis di: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=YOUR_NASA_FIRMS_MAP_KEY
# Sumber data satelit: VIIRS_SNPP_NRT, VIIRS_NOAA20_NRT, VIIRS_NOAA21_NRT, MODIS_NRT
FIRMS_SOURCE=VIIRS_SNPP_NRT
# Kode negara (ISO 3166-1 alpha-3): IDN untuk Indonesia
FIRMS_COUNTRY=IDN
# Jumlah hari mundur pengecekan (1 = 24 jam terakhir, max 10 untuk NRT)
FIRMS_DAY_RANGE=1

# 2. TELEGRAM NOTIFICATION (Opsional)
# Buat bot via @BotFather, dapatkan Token dan Chat ID grup/pribadi
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 3. WHATSAPP NOTIFICATION (Opsional - Mendukung Baileys / WPPConnect / Evolution API)
WHATSAPP_ENABLED=false
WHATSAPP_WEBHOOK_URL=http://localhost:3000/api/send-message
WHATSAPP_TARGET_NUMBER=628123456789@s.whatsapp.net
WHATSAPP_AUTH_TOKEN=

# 4. MONITORING & DATABASE SETTINGS
DB_PATH=jaga_hutan.db
LOCATIONS_FILE=locations.json
# Waktu cooldown alert hotspot berulang dalam hitungan jam (mencegah spam)
ALERT_COOLDOWN_HOURS=12
# Interval pengecekan untuk mode daemon (dalam menit)
CHECK_INTERVAL_MINUTES=60

# 5. WEB DASHBOARD SETTINGS
WEB_HOST=0.0.0.0
WEB_PORT=8000
